{
  "name": "waymark",
  "version": "0.2.0",
  "description": "Hierarchical, line-anchored maps of how code executes — MCP server, CLI and shareable HTML viewer for agentic harnesses",
  "main": "src/mcp.js",
  "scripts": {
    "test": "node --test test/waymark.test.js test/narrative.test.js test/agentic.test.js test/vscode.test.js",
    "mcp": "node src/mcp.js",
    "vscode:package": "cd vscode && npx --yes @vscode/vsce@latest package --no-dependencies",
    "vscode:install": "node src/cli.js install --no-claude --no-codex --no-agents-md --vscode",
    "version:set": "node scripts/set-version.mjs",
    "update": "node src/cli.js update --claude-global --vscode"
  },
  "keywords": [
    "mcp",
    "waymark",
    "code-map",
    "agents",
    "claude-code",
    "codemaps",
    "codex",
    "code-navigation"
  ],
  "author": "h0w4r",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "type": "module",
  "bin": {
    "waymark": "src/cli.js",
    "waymark-mcp": "src/mcp.js"
  },
  "files": [
    "src",
    "vscode/extension.js",
    "vscode/lib",
    "vscode/media",
    "vscode/package.json",
    "vscode/README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h0w4r/waymark.git"
  },
  "homepage": "https://github.com/h0w4r/waymark#readme",
  "bugs": {
    "url": "https://github.com/h0w4r/waymark/issues"
  }
}
