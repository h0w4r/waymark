{
  "name": "waymark",
  "displayName": "Waymark",
  "version": "0.3.0",
  "description": "Narrated, line-anchored maps of how code executes: traces, storytelling guides, per-node explanations, fact-checking, interactive viewer, drift detection and agent hooks.",
  "author": {
    "name": "h0w4r",
    "url": "https://github.com/h0w4r"
  },
  "homepage": "https://github.com/h0w4r/waymark",
  "repository": "https://github.com/h0w4r/waymark",
  "license": "MIT",
  "keywords": [
    "codemap",
    "code-map",
    "architecture",
    "onboarding",
    "documentation",
    "mcp"
  ],
  "mcpServers": {
    "waymark": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/waymark.mjs",
        "mcp"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/waymark.mjs",
              "hook",
              "pre-edit"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/waymark.mjs",
              "hook",
              "post-edit"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/waymark.mjs",
              "hook",
              "post-read"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
